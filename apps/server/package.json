{
  "name": "@princetheprogrammerbtw/openbuff",
  "version": "0.0.40",
  "description": "Open-source, ad-free web experience for Freebuff — a local server + web UI for the free AI coding agent, powered by the real Freebuff engine on your machine.",
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "freebuff",
    "local-first",
    "web-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/10xdev4u-alt/openbuff",
    "directory": "apps/server"
  },
  "bin": {
    "openbuff": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build:bundle": "vp pack && vp pack src/service-launcher.ts --out-dir dist --no-clean",
    "start": "node src/bin.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@codebuff/sdk": "^0.10.7",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "msgpackr-extract": "3.0.4",
    "node-pty": "1.2.0-beta.15",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "bundleDependencies": [
    "@codebuff/sdk"
  ],
  "overrides": {
    "@ai-sdk/anthropic": "2.0.102",
    "undici@^5.29.0": "6.28.1"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
