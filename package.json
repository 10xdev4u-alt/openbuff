{
  "name": "openbuff-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/clean-tsgo-backups.mjs && effect-tsgo patch",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:share": "node scripts/dev-runner.ts dev --share",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "migrate-dev-db": "node apps/server/scripts/migrate-dev-db.ts",
    "start": "pnpm --filter t3 start",
    "start:mock-update-server": "node scripts/mock-update-server.ts",
    "icons:export": "node scripts/export-brand-icons.ts",
    "icons:check": "node scripts/export-brand-icons.ts --check",
    "build": "pnpm --filter './apps/*' --filter './packages/*' --filter './oxlint-plugin-t3code' --filter './scripts' run build",
    "build:resource-monitor": "cargo build --locked --release --manifest-path native/resource-monitor/Cargo.toml",
    "typecheck": "pnpm -r --workspace-concurrency 2 run typecheck",
    "tc": "pnpm -r --workspace-concurrency 2 run typecheck",
    "test": "pnpm -r run test",
    "test:resource-monitor": "cargo test --locked --manifest-path native/resource-monitor/Cargo.toml",
    "build:contracts": "pnpm --filter @t3tools/contracts run build",
    "release:smoke": "node scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus",
    "sync:repos": "node scripts/sync-reference-repos.ts"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "^1.63.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "packageManager": "pnpm@11.10.0",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
